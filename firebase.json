{
  "hosting": {
    "public": "apps/website/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/downloads/**"
    ],

    "redirects": [
      {
        "source": "/downloads/KnowTheMD_Windows_x64_Setup.exe",
        "destination": "https://github.com/MrGokulaKrishnan/KnowTheMD/releases/download/v1.0.0/KnowTheMD_Windows_x64_Setup.exe",
        "type": 302
      },
      {
        "source": "/downloads/KnowTheMD_Windows_x64.zip",
        "destination": "https://github.com/MrGokulaKrishnan/KnowTheMD/releases/download/v1.0.0/KnowTheMD_Windows_x64.zip",
        "type": 302
      },
      {
        "source": "/downloads/KnowTheMD-1.0.0-android.apk",
        "destination": "https://github.com/MrGokulaKrishnan/KnowTheMD/releases/download/v1.0.0/KnowTheMD-1.0.0-android.apk",
        "type": 302
      },
      {
        "source": "/downloads/KnowTheMD-1.0.0-linux-x64.tar.gz",
        "destination": "https://github.com/MrGokulaKrishnan/KnowTheMD/releases/download/v1.0.0/KnowTheMD-1.0.0-linux-x64.tar.gz",
        "type": 302
      }
    ],

    "headers": [
      {
        "source": "/downloads/**/*.apk",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/downloads/**/*.pkg",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"KnowTheMD-1.0.0-android.apk\"" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "Accept-Ranges", "value": "bytes" }
        ]
      },
      {
        "source": "/downloads/KnowTheMD_Windows_x64_Setup.exe",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.microsoft.portable-executable" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"KnowTheMD_Windows_x64_Setup.exe\"" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "Accept-Ranges", "value": "bytes" }
        ]
      },
      {
        "source": "/downloads/KnowTheMD_Windows_x64_Setup.pkg",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.microsoft.portable-executable" },
          { "key": "Content-Disposition", "value": "attachment; filename=\"KnowTheMD_Windows_x64_Setup.exe\"" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "Accept-Ranges", "value": "bytes" }
        ]
      },
      {
        "source": "/downloads/**/*.exe",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.microsoft.portable-executable" },
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "Accept-Ranges", "value": "bytes" }
        ]
      },
      {
        "source": "/downloads/**/*.zip",
        "headers": [
          { "key": "Content-Type", "value": "application/zip" },
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
          { "key": "Accept-Ranges", "value": "bytes" }
        ]
      },
      {
        "source": "/downloads/**/*.dmg",
        "headers": [
          { "key": "Content-Type", "value": "application/x-apple-diskimage" },
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/downloads/**/*.AppImage",
        "headers": [
          { "key": "Content-Type", "value": "application/octet-stream" },
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/downloads/**/*.deb",
        "headers": [
          { "key": "Content-Type", "value": "application/vnd.debian.binary-package" },
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/downloads/**/*.msi",
        "headers": [
          { "key": "Content-Type", "value": "application/octet-stream" },
          { "key": "Content-Disposition", "value": "attachment" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/**/*.{png,jpg,jpeg,ico,svg}",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/downloads/KnowTheMD-1.0.0-android.apk",
        "destination": "/downloads/KnowTheMD-1.0.0-android.pkg"
      },
      {
        "source": "/downloads/KnowTheMD_Windows_x64_Setup.exe",
        "destination": "/downloads/KnowTheMD_Windows_x64_Setup.pkg"
      },
      {
        "source": "/downloads/**",
        "destination": "/download-not-found.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true
  }
}
